{
  "name": "@inlayphp/resources-react",
  "version": "0.3.3",
  "description": "React renderer for Inlay resources and relation managers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external @inertiajs/react --external @inlayphp/actions --external @inlayphp/actions-react --external @inlayphp/resources --external @inlayphp/forms-react --external @inlayphp/tables-react --external @inlayphp/widgets-react --external @inlayphp/ui-react",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@inertiajs/react": "^3.0.0",
    "@inlayphp/actions": "workspace:^",
    "@inlayphp/actions-react": "workspace:^",
    "react": "^19.0.0",
    "@inlayphp/resources": "workspace:^",
    "@inlayphp/forms-react": "workspace:^",
    "@inlayphp/tables-react": "workspace:^",
    "@inlayphp/widgets-react": "workspace:^",
    "@inlayphp/ui-react": "workspace:^"
  },
  "devDependencies": {
    "@inertiajs/react": "^3.6.1",
    "@inlayphp/actions": "workspace:^",
    "@inlayphp/actions-react": "workspace:^",
    "@inlayphp/widgets-react": "workspace:^",
    "@inlayphp/ui-react": "workspace:^",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/InlayPHP/inlay.git",
    "directory": "packages/resources/react"
  },
  "homepage": "https://github.com/InlayPHP/inlay/tree/main/packages/resources/react",
  "bugs": {
    "url": "https://github.com/InlayPHP/inlay/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
